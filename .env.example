# Copy to .env locally. Never commit .env or a service-account key.
# Every VITE_ value is public and included in the browser build.

# Firebase web app configuration: Firebase Console > Project settings > Your apps.
# Use a separate Firebase project for local development; no emulator is auto-connected.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: enables Firebase Analytics initialization when supplied.
VITE_FIREBASE_MEASUREMENT_ID=

# Staff owner: use a real mailbox, matching ownerEmail() in firestore.rules.
# Owner setup requires email verification before admin access is granted.
VITE_ADMIN_OWNER_EMAIL=

# Optional YouPI gateway. Leave BOTH empty to disable online checkout.
# Supplying these enables the online button; it does not check server readiness.
# Example gateway origin: https://pay.example.com (HTTPS required in production).
VITE_YOUPI_BASE_URL=
VITE_YOUPI_MERCHANT_KEY=
VITE_STORE_NAME=Ice Age Creamery

# Server-only credentials: never use a VITE_ prefix.
# Configure these as runtime secrets on the deployment host.
YOUPI_WEBHOOK_SECRET=
# One-line JSON service-account key for the SAME Firebase project as the client:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use these three fields instead of JSON. Literal \n in the private key is supported.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local payment simulation ONLY, using a separate development Firebase project.
# Simulation changes real database records without moving money.
# Requires server credentials above, localhost and a development/test environment.
# Keep these flags unset in production build and runtime environments.
# VITE_PAYMENT_MODE=test
# ALLOW_TEST_PAYMENTS=true
# NODE_ENV=development
